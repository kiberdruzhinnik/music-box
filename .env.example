# Choose exactly one mode.

# Subscription mode: URL returning a plain URI list, Base64 URI list, or JSON
# containing share URLs (vless://, vmess://, trojan://, hysteria2://, etc.).
SUBSCRIPTION_URL='https://provider.example/subscription/token'

# Direct/single-node compatibility mode. Leave empty when SUBSCRIPTION_URL is set.
UPSTREAM_URL=

# Country selection is applied to the human-readable node name. For most URI
# formats this is the #fragment; for vmess:// the wrapper reads the JSON "ps" field.
COUNTRY=Netherlands

# Optional regex instead of COUNTRY. If non-empty, COUNTRY_REGEX wins.
# Example: (?i)(🇳🇱|Netherlands|\bNL\b)
COUNTRY_REGEX=

# Reverse matched subscription order before probing. This mainly affects probe
# order/tie-breaking because the final choice is always the lowest measured RTT.
REVERSE_MATCHES=true

# Refresh subscription and benchmark cadence.
SUBSCRIPTION_REFRESH_SECONDS=86400
PROBE_INTERVAL_SECONDS=43200

# Health-check only the currently active proxy at this interval. A failed check
# is retried before failover, preventing a one-off network blip from switching nodes.
HEALTHCHECK_INTERVAL_SECONDS=60
HEALTHCHECK_FAILURE_THRESHOLD=2
HEALTHCHECK_RETRY_DELAY_SECONDS=2

# Exact probe requested: HTTP GET through each candidate proxy; only HTTP 204 passes.
# TCP_TEST_URL is the preferred override. TEST_URL remains supported for backward compatibility.
TCP_TEST_URL=https://www.gstatic.com/generate_204
# TEST_URL=
PROBE_TIMEOUT_SECONDS=8
PROBE_ATTEMPTS=2
PROBE_CONCURRENCY=4

# When no subscription proxy can be activated, retry both the subscription
# refresh and benchmark on this short cadence instead of the normal intervals.
UNAVAILABLE_RETRY_SECONDS=30

# 0 = all matched nodes. Set e.g. 20 to cap expensive probe cycles.
MAX_CANDIDATES=0

# Ports exposed on the Docker host.
SOCKS5_PORT=10800
HTTP_PORT=10801
BIND_ADDRESS=127.0.0.1

# Image build versions.
SING_BOX_VERSION=1.14.1
SB2P_VERSION=0.3.4
