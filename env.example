# Quote the whole share URL. Supported by singbox2proxy include vless://,
# vmess://, trojan://, hysteria2:// / hy2://, ss://, tuic:// and others.
UPSTREAM_URL='vless://UUID@example.com:443?security=tls&type=tcp&sni=example.com#my-proxy'

# Ports exposed on the Docker host.
SOCKS5_PORT=10800
HTTP_PORT=10801

# 127.0.0.1 = host-only. Use 0.0.0.0 only when LAN clients need access.
BIND_ADDRESS=127.0.0.1

# Image build versions.
SING_BOX_VERSION=1.14.1
SB2P_REF=main
